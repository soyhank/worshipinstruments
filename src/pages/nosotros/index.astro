---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config/site';
import { products, categories } from '../../lib/catalog';
import { storeSchema, breadcrumbSchema } from '../../lib/schema';

const breadcrumbItems = [
  { name: 'Inicio', url: '/' },
  { name: 'Nosotros', url: '/nosotros/' },
];
const valores = [
  { icon: 'shield', t: 'Equipos originales', d: 'Trabajamos con marcas oficiales y garantía.' },
  { icon: 'whatsapp', t: 'Asesoría real', d: 'Te orientamos según tu iglesia, estudio o proyecto.' },
  { icon: 'truck', t: 'Cobertura nacional', d: 'Enviamos a Lima y todas las provincias del Perú.' },
  { icon: 'music', t: 'Especialistas en sonido', d: 'Proaudio, video e instrumentos para alabanza.' },
];
---
<Layout
  title={`Nosotros | ${SITE.name}`}
  description="Worship Instruments es tu tienda de proaudio, video e instrumentos musicales en Lima, Perú. Equipos originales, asesoría experta y envíos a todo el país."
  canonical="/nosotros/"
  jsonLd={[storeSchema(), breadcrumbSchema(breadcrumbItems)]}>
  <Breadcrumbs items={breadcrumbItems} />
  <section class="container-page grid gap-12 py-12 lg:grid-cols-2">
    <div class="prose-wi max-w-none">
      <h1 class="text-3xl font-extrabold text-brand-950">Sobre Worship Instruments</h1>
      <p>En <strong>Worship Instruments</strong> nos especializamas en <strong>proaudio, video e instrumentos musicales</strong> para iglesias, músicos, estudios y profesionales del sonido en todo el Perú. Nuestro lema lo dice todo: <em>sonido para iglesia</em>.</p>
      <p>Ofrecemos una selección cuidada de <strong>{products.length} productos</strong> de las marcas más reconocidas del mercado —desde micrófonos profesionales y consolas digitales hasta parlantes activos, pianos digitales, baterías electrónicas y switchers de video— con <strong>precios en soles</strong> y entrega a nivel nacional.</p>
      <p>Más que vender equipos, te <strong>asesoramos</strong> para que elijas la solución correcta según tu presupuesto y necesidad. Escríbenos por WhatsApp y con gusto te ayudamos.</p>
    </div>
    <div class="grid grid-cols-2 gap-4 self-start">
      {valores.map((v) => (
        <div class="rounded-2xl border border-brand-100 bg-white p-5">
          <span class="grid h-11 w-11 place-items-center rounded-lg bg-brand-50 text-brand-600"><Icon name={v.icon} size={22} /></span>
          <p class="mt-3 font-bold text-brand-900">{v.t}</p>
          <p class="mt-1 text-sm text-brand-600">{v.d}</p>
        </div>
      ))}
      <div class="col-span-2 rounded-2xl bg-brand-900 p-6 text-white">
        <div class="flex items-center gap-3">
          <Icon name="pin" size={22} class="text-gold-400" />
          <div>
            <p class="font-bold">Visítanos</p>
            <p class="text-sm text-brand-200">Av. Mariano Cornejo 1009, Of. 203 — Pueblo Libre, Lima</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-brand-50 py-12">
    <div class="container-page grid grid-cols-2 gap-6 text-center sm:grid-cols-4">
      <div><p class="text-3xl font-black text-brand-700">{products.length}+</p><p class="text-sm text-brand-600">Productos</p></div>
      <div><p class="text-3xl font-black text-brand-700">{categories.length}</p><p class="text-sm text-brand-600">Categorías</p></div>
      <div><p class="text-3xl font-black text-brand-700">24</p><p class="text-sm text-brand-600">Provincias atendidas</p></div>
      <div><p class="text-3xl font-black text-brand-700">100%</p><p class="text-sm text-brand-600">Equipos originales</p></div>
    </div>
  </section>
  <CTASection />
</Layout>
