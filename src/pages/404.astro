---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { whatsappLink } from '../config/site';
---
<Layout title="Página no encontrada (404)" description="La página que buscas no existe. Explora nuestros productos de proaudio e instrumentos." noindex>
  <section class="grid place-items-center px-4 py-24 text-center">
    <div class="max-w-lg">
      <span class="mx-auto grid h-20 w-20 place-items-center rounded-2xl bg-brand-700 text-gold-400"><Icon name="music" size={40} /></span>
      <p class="mt-6 text-6xl font-black text-brand-800">404</p>
      <h1 class="mt-2 text-2xl font-bold text-brand-900">No encontramos esta página</h1>
      <p class="mt-3 text-brand-600">Puede que el enlace haya cambiado. Te ayudamos a encontrar lo que buscas.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/" class="inline-flex items-center gap-2 rounded-xl bg-brand-700 px-6 py-3 font-bold text-white hover:bg-brand-800"><Icon name="arrow" size={18} class="rotate-180" /> Ir al inicio</a>
        <a href="/productos/" class="inline-flex items-center gap-2 rounded-xl bg-gold-400 px-6 py-3 font-bold text-ink hover:bg-gold-300">Ver productos</a>
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-3 text-sm">
        <a href="/categorias/" class="text-brand-600 underline underline-offset-2">Categorías</a>
        <a href="/ofertas/" class="text-brand-600 underline underline-offset-2">Ofertas</a>
        <a href={whatsappLink()} target="_blank" rel="noopener" class="text-brand-600 underline underline-offset-2">WhatsApp</a>
      </div>
    </div>
  </section>
</Layout>
