---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { SITE, CONTACT, SOCIAL, whatsappLink } from '../../config/site';
import { storeSchema, breadcrumbSchema } from '../../lib/schema';

const breadcrumbItems = [
  { name: 'Inicio', url: '/' },
  { name: 'Contacto', url: '/contacto/' },
];
---
<Layout
  title={`Contacto | ${SITE.name}`}
  description="Contáctanos para cotizar proaudio, video o instrumentos musicales en Lima, Perú. WhatsApp +51 997 597 511. Envíos a todo el país."
  canonical="/contacto/"
  jsonLd={[storeSchema(), breadcrumbSchema(breadcrumbItems)]}>
  <Breadcrumbs items={breadcrumbItems} />
  <section class="container-page py-10">
    <header class="max-w-2xl">
      <h1 class="text-3xl font-extrabold text-brand-950">Contáctanos</h1>
      <p class="mt-2 text-brand-600">Cuéntanos qué equipo necesitas y te cotizamos al instante. La forma más rápida es por WhatsApp.</p>
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_380px]">
      <div class="rounded-2xl border border-brand-100 bg-white p-6 sm:p-8">
        <!-- IMPORTANTE: conecta el form a un servicio (Web3Forms/Formspree). Reemplaza {{FORM_ENDPOINT}}. -->
        <form action="{{FORM_ENDPOINT}}" method="POST" class="grid gap-4 sm:grid-cols-2">
          <div><label for="nombre" class="block text-sm font-medium text-brand-700">Nombre*</label>
            <input id="nombre" name="nombre" type="text" required autocomplete="name" class="mt-1 w-full rounded-lg border border-brand-200 px-3 py-2.5 outline-none focus:border-brand-500" /></div>
          <div><label for="telefono" class="block text-sm font-medium text-brand-700">WhatsApp / Teléfono*</label>
            <input id="telefono" name="telefono" type="tel" required autocomplete="tel" class="mt-1 w-full rounded-lg border border-brand-200 px-3 py-2.5 outline-none focus:border-brand-500" /></div>
          <div class="sm:col-span-2"><label for="email" class="block text-sm font-medium text-brand-700">Correo</label>
            <input id="email" name="email" type="email" autocomplete="email" class="mt-1 w-full rounded-lg border border-brand-200 px-3 py-2.5 outline-none focus:border-brand-500" /></div>
          <div class="sm:col-span-2"><label for="mensaje" class="block text-sm font-medium text-brand-700">¿Qué equipo buscas?</label>
            <textarea id="mensaje" name="mensaje" rows="4" class="mt-1 w-full rounded-lg border border-brand-200 px-3 py-2.5 outline-none focus:border-brand-500" placeholder="Ej.: micrófono dinámico para voz, consola digital de 16 canales…"></textarea></div>
          <div class="sm:col-span-2">
            <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-700 px-6 py-3 font-bold text-white transition hover:bg-brand-800 sm:w-auto">
              <Icon name="mail" size={18} /> Enviar consulta
            </button>
            <p class="mt-3 text-xs text-brand-500">¿Respuesta inmediata? Escríbenos por WhatsApp.</p>
          </div>
        </form>
      </div>

      <aside class="space-y-4">
        <a href={whatsappLink()} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-2xl bg-[#25D366] p-5 font-bold text-white transition hover:brightness-95">
          <Icon name="whatsapp" size={28} />
          <span>WhatsApp directo<span class="block text-sm font-normal text-white/90">{CONTACT.whatsappDisplay}</span></span>
        </a>
        <div class="rounded-2xl border border-brand-100 bg-white p-6">
          <h2 class="text-lg font-bold text-brand-900">Datos de contacto</h2>
          <ul class="mt-4 space-y-4 text-sm">
            <li class="flex items-start gap-3"><Icon name="pin" size={20} class="mt-0.5 shrink-0 text-brand-600" /><div><p class="font-medium text-brand-800">Dirección</p><p class="text-brand-600">{CONTACT.address.street}, {CONTACT.address.district}, {CONTACT.address.city}</p></div></li>
            <li class="flex items-start gap-3"><Icon name="phone" size={20} class="mt-0.5 shrink-0 text-brand-600" /><div><p class="font-medium text-brand-800">Teléfono / WhatsApp</p><a href={`tel:+${CONTACT.phone}`} class="text-brand-600 hover:text-brand-700">{CONTACT.whatsappDisplay}</a></div></li>
            <li class="flex items-start gap-3"><Icon name="clock" size={20} class="mt-0.5 shrink-0 text-brand-600" /><div><p class="font-medium text-brand-800">Horario</p><p class="text-brand-600">Lunes a Sábado, 10:00 – 19:00</p></div></li>
          </ul>
          <div class="mt-5 flex gap-3">
            {SOCIAL.facebook && <a href={SOCIAL.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="grid h-9 w-9 place-items-center rounded-lg bg-brand-50 text-brand-600 hover:bg-brand-100"><Icon name="facebook" size={18} /></a>}
            {SOCIAL.instagram && <a href={SOCIAL.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="grid h-9 w-9 place-items-center rounded-lg bg-brand-50 text-brand-600 hover:bg-brand-100"><Icon name="instagram" size={18} /></a>}
            {SOCIAL.youtube && <a href={SOCIAL.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="grid h-9 w-9 place-items-center rounded-lg bg-brand-50 text-brand-600 hover:bg-brand-100"><Icon name="youtube" size={18} /></a>}
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>
