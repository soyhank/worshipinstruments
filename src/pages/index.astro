---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import { SITE, whatsappLink } from '../config/site';
import {
  products, categories, onSaleProducts, allBrands,
  primaryImage, categoryPath, productPath,
} from '../lib/catalog';
import { storeSchema, itemListSchema } from '../lib/schema';

const featured = onSaleProducts().slice(0, 8);
const heroProduct = products.find((p) => /piano|fp30x|fantom|psr/i.test(p.name)) ?? products[0];
const heroImg = heroProduct ? primaryImage(heroProduct) : undefined;
const brands = allBrands().slice(0, 10);
const topCats = categories.slice(0, 8);

const valores = [
  { icon: 'truck', t: 'Envíos a todo el Perú', d: 'Despacho seguro a Lima y provincias.' },
  { icon: 'shield', t: 'Productos originales', d: 'Marcas oficiales con garantía.' },
  { icon: 'whatsapp', t: 'Asesoría especializada', d: 'Te ayudamos a elegir tu equipo.' },
  { icon: 'tag', t: 'Precios en soles', d: 'Sin sorpresas, IGV incluido.' },
];

const jsonLd = [storeSchema(), itemListSchema(featured, productPath)];
---
<Layout
  title={`Worship Instruments | Proaudio, Video e Instrumentos en Lima, Perú`}
  description={SITE.description}
  jsonLd={jsonLd}>

  <!-- HERO -->
  <section class="relative overflow-hidden bg-brand-950 text-white">
    <div class="pointer-events-none absolute inset-0 opacity-30" aria-hidden="true"
      style="background-image: radial-gradient(circle at 15% 20%, #1b75bc 0, transparent 45%), radial-gradient(circle at 85% 10%, #ffd400 0, transparent 28%);"></div>
    <div class="container-page relative grid items-center gap-10 py-16 lg:grid-cols-2 lg:py-24">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-xs font-semibold uppercase tracking-wide text-gold-300">
          <Icon name="music" size={14} /> Sonido para iglesia · Proaudio · Video
        </p>
        <h1 class="mt-4 text-4xl font-black leading-tight sm:text-5xl">
          Equipos de audio profesional e <span class="text-gold-400">instrumentos</span> en Lima
        </h1>
        <p class="mt-5 max-w-xl text-lg text-brand-200">
          Micrófonos, consolas digitales, parlantes, pianos y baterías electrónicas de las mejores marcas. Asesoría experta y envíos a todo el Perú.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/productos/" class="inline-flex items-center justify-center gap-2 rounded-xl bg-gold-400 px-6 py-3.5 font-extrabold text-ink transition hover:bg-gold-300">
            Ver productos <Icon name="arrow" size={20} />
          </a>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/25 px-6 py-3.5 font-semibold text-white transition hover:bg-white/10">
            <Icon name="whatsapp" size={20} /> Cotizar ahora
          </a>
        </div>
        <p class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-brand-300">
          <span class="inline-flex items-center gap-1.5"><Icon name="check" size={16} class="text-gold-400" /> {products.length}+ productos</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="check" size={16} class="text-gold-400" /> Marcas originales</span>
          <span class="inline-flex items-center gap-1.5"><Icon name="check" size={16} class="text-gold-400" /> Envíos a todo el país</span>
        </p>
      </div>
      {heroImg && (
        <div class="relative">
          <div class="mx-auto max-w-md rounded-3xl bg-white p-6 shadow-2xl">
            <Image src={heroImg} alt={heroProduct!.name} widths={[400, 700]} sizes="(max-width:1024px) 80vw, 420px" loading="eager" class="aspect-square w-full object-contain" />
          </div>
        </div>
      )}
    </div>
    <div class="absolute inset-x-0 bottom-0 h-1.5 bg-gold-400" aria-hidden="true"></div>
  </section>

  <!-- VALORES -->
  <section class="border-b border-brand-100 bg-brand-50">
    <div class="container-page grid grid-cols-2 gap-6 py-8 lg:grid-cols-4">
      {valores.map((v) => (
        <div class="flex items-start gap-3">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-white text-brand-600 shadow-sm"><Icon name={v.icon} size={22} /></span>
          <div>
            <p class="text-sm font-bold text-brand-900">{v.t}</p>
            <p class="text-xs text-brand-600">{v.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CATEGORIAS -->
  <section class="py-16">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-brand-500">Explora</p>
          <h2 class="mt-1 text-3xl font-extrabold text-brand-950">Categorías destacadas</h2>
        </div>
        <a href="/categorias/" class="inline-flex items-center gap-1 font-semibold text-brand-600 hover:text-brand-700">Ver todas <Icon name="arrow" size={16} /></a>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {topCats.map((c) => (
          <a href={categoryPath(c.slug)} class="group flex items-center justify-between rounded-2xl border border-brand-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-card">
            <div>
              <h3 class="font-bold text-brand-900 group-hover:text-brand-600">{c.name}</h3>
              <p class="text-xs text-brand-500">{c.count} productos</p>
            </div>
            <Icon name="chevron" size={18} class="text-brand-400 transition group-hover:translate-x-1" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- DESTACADOS / OFERTAS -->
  <section class="bg-brand-50 py-16">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-gold-600">Ofertas</p>
          <h2 class="mt-1 text-3xl font-extrabold text-brand-950">Productos destacados</h2>
        </div>
        <a href="/ofertas/" class="inline-flex items-center gap-1 font-semibold text-brand-600 hover:text-brand-700">Ver ofertas <Icon name="arrow" size={16} /></a>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- MARCAS -->
  <section class="py-14">
    <div class="container-page text-center">
      <h2 class="text-2xl font-extrabold text-brand-950">Marcas que trabajamos</h2>
      <p class="mx-auto mt-2 max-w-2xl text-brand-600">Equipos originales de fabricantes líderes en proaudio e instrumentos.</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        {brands.map((b) => (
          <span class="rounded-full border border-brand-100 bg-white px-5 py-2 text-sm font-bold uppercase tracking-wide text-brand-700 shadow-sm">{b.name}</span>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
