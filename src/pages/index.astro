---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ProductCard from '../components/ProductCard.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import { SITE, whatsappLink } from '../config/site';
import {
  products, categories, onSaleProducts, allBrands,
  primaryImage, categoryPath, productPath, productsByCategory,
} from '../lib/catalog';
import { storeSchema, itemListSchema } from '../lib/schema';

const featured = onSaleProducts().slice(0, 5);
const grid = onSaleProducts().slice(0, 8);
const brands = allBrands().slice(0, 10);
const catTiles = categories.slice(0, 6).map((c) => {
  const prods = productsByCategory(c.slug);
  return { c, img: prods[0] ? primaryImage(prods[0]) : undefined };
});

const valores = [
  { icon: 'truck', t: 'Envíos a todo el Perú', d: 'Despacho seguro a Lima y provincias.' },
  { icon: 'shield', t: 'Productos originales', d: 'Marcas oficiales con garantía.' },
  { icon: 'whatsapp', t: 'Asesoría especializada', d: 'Te ayudamos a elegir tu equipo.' },
  { icon: 'tag', t: 'Precios en soles', d: 'Sin sorpresas, IGV incluido.' },
];

const jsonLd = [storeSchema(), itemListSchema(grid, productPath)];
---
<Layout
  title={`Worship Instruments | Proaudio, Video e Instrumentos en Lima, Perú`}
  description={SITE.description}
  jsonLd={jsonLd}>

  <HeroCarousel products={featured} />

  <!-- VALORES -->
  <section class="border-b border-brand-100 bg-white">
    <div class="container-page grid grid-cols-2 gap-6 py-8 lg:grid-cols-4">
      {valores.map((v, i) => (
        <div data-reveal data-delay={String(i % 4)} class="flex items-start gap-3">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600"><Icon name={v.icon} size={22} /></span>
          <div>
            <p class="text-sm font-bold text-brand-900">{v.t}</p>
            <p class="text-xs text-brand-600">{v.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CATEGORIAS (tiles image-forward) -->
  <section class="py-20">
    <div class="container-page">
      <div data-reveal class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Explora el catálogo</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-brand-950 sm:text-4xl">Categorías</h2>
        </div>
        <a href="/categorias/" class="link-cta">Ver todas <Icon name="arrow" size={18} /></a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-5 md:grid-cols-3">
        {catTiles.map(({ c, img }, i) => (
          <a href={categoryPath(c.slug)} data-reveal data-delay={String(i % 3)}
            class="group relative overflow-hidden rounded-3xl border border-brand-100 bg-brand-50">
            <div class="img-zoom aspect-[4/3] p-8">
              {img ? (
                <Image src={img} alt={c.name} widths={[300, 600]} sizes="(max-width:768px) 50vw, 33vw" loading="lazy" class="h-full w-full object-contain" />
              ) : (
                <div class="grid h-full place-items-center text-brand-200"><Icon name="music" size={56} /></div>
              )}
            </div>
            <div class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 bg-gradient-to-t from-brand-950/85 to-transparent p-5 pt-12 text-white">
              <div>
                <h3 class="text-lg font-extrabold leading-tight">{c.name}</h3>
                <p class="text-xs text-white/70">{c.count} productos</p>
              </div>
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-white/15 backdrop-blur transition group-hover:bg-gold-400 group-hover:text-ink">
                <Icon name="arrow" size={18} />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- DESTACADOS -->
  <section class="bg-brand-50 py-20">
    <div class="container-page">
      <div data-reveal class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow text-gold-600">Ofertas de la semana</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-brand-950 sm:text-4xl">Productos destacados</h2>
        </div>
        <a href="/ofertas/" class="link-cta">Ver ofertas <Icon name="arrow" size={18} /></a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-x-5 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
        {grid.map((p, i) => (
          <div data-reveal data-delay={String(i % 4)}><ProductCard product={p} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- BANNER ASESORIA (split oscuro estilo editorial) -->
  <section class="py-20">
    <div class="container-page">
      <div data-reveal class="overflow-hidden rounded-3xl bg-brand-950 text-white">
        <div class="grid items-center gap-8 p-8 sm:p-12 lg:grid-cols-2 lg:p-16">
          <div>
            <p class="eyebrow text-gold-300">Sonido para iglesia</p>
            <h2 class="mt-3 text-3xl font-black leading-tight tracking-tight sm:text-4xl">¿No sabes qué equipo necesitas?</h2>
            <p class="mt-4 max-w-md text-brand-200">Te asesoramos para armar el setup ideal de tu iglesia, banda o estudio según tu presupuesto. Respuesta rápida por WhatsApp.</p>
            <a href={whatsappLink()} target="_blank" rel="noopener" class="mt-7 inline-flex items-center gap-2 rounded-xl bg-gold-400 px-6 py-3.5 font-extrabold text-ink transition hover:bg-gold-300">
              <Icon name="whatsapp" size={20} /> Hablar con un asesor
            </a>
          </div>
          <div class="grid grid-cols-3 gap-3">
            {['Micrófonos', 'Consolas', 'Parlantes', 'Pianos', 'Baterías', 'Video'].map((t) => (
              <div class="rounded-xl border border-white/10 bg-white/5 px-3 py-4 text-center text-sm font-semibold text-brand-100">{t}</div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARCAS -->
  <section class="pb-20">
    <div class="container-page text-center">
      <div data-reveal>
        <p class="eyebrow">Trabajamos con</p>
        <h2 class="mt-2 text-2xl font-black tracking-tight text-brand-950 sm:text-3xl">Marcas líderes en proaudio</h2>
      </div>
      <div data-reveal class="mt-8 flex flex-wrap items-center justify-center gap-3">
        {brands.map((b) => (
          <span class="rounded-full border border-brand-100 bg-white px-5 py-2 text-sm font-bold uppercase tracking-wide text-brand-700 shadow-sm transition hover:border-brand-300 hover:text-brand-900">{b.name}</span>
        ))}
      </div>
    </div>
  </section>

  <CTASection />
</Layout>
