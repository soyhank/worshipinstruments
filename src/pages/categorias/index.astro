---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config/site';
import { categories, productsByCategory, primaryImage, categoryPath } from '../../lib/catalog';
import { breadcrumbSchema } from '../../lib/schema';

const cards = categories.map((c) => {
  const prods = productsByCategory(c.slug);
  return { c, img: prods[0] ? primaryImage(prods[0]) : undefined };
});
const breadcrumbItems = [
  { name: 'Inicio', url: '/' },
  { name: 'Categorías', url: '/categorias/' },
];
---
<Layout
  title={`Categorías de Productos | ${SITE.name}`}
  description="Explora nuestras categorías: micrófonos, consolas digitales, parlantes, pianos, baterías electrónicas, sintetizadores y video. Proaudio en Lima, Perú."
  canonical="/categorias/"
  jsonLd={[breadcrumbSchema(breadcrumbItems)]}>
  <Breadcrumbs items={breadcrumbItems} />
  <section class="container-page py-8">
    <header data-reveal class="max-w-3xl">
      <p class="eyebrow">Explora</p>
      <h1 class="mt-2 text-4xl font-black tracking-tight text-brand-950">Categorías</h1>
      <p class="mt-2 text-brand-600">Encuentra el equipo que necesitas por categoría.</p>
    </header>
    <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
      {cards.map(({ c, img }, i) => (
        <a href={categoryPath(c.slug)} data-reveal data-delay={String(i % 4)}
          class="group relative overflow-hidden rounded-3xl border border-brand-100 bg-brand-50">
          <div class="img-zoom aspect-square p-6">
            {img ? (
              <Image src={img} alt={c.name} widths={[200, 400]} sizes="(max-width:640px) 50vw, 25vw" loading="lazy" class="h-full w-full object-contain" />
            ) : (
              <div class="grid h-full place-items-center text-brand-200"><Icon name="music" size={48} /></div>
            )}
          </div>
          <div class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-2 bg-gradient-to-t from-brand-950/85 to-transparent p-4 pt-10 text-white">
            <div>
              <h2 class="font-extrabold leading-tight">{c.name}</h2>
              <p class="text-xs text-white/70">{c.count} {c.count === 1 ? 'producto' : 'productos'}</p>
            </div>
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white/15 backdrop-blur transition group-hover:bg-gold-400 group-hover:text-ink"><Icon name="arrow" size={16} /></span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <CTASection />
</Layout>
