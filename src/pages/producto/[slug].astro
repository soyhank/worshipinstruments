---
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductCard from '../../components/ProductCard.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import { whatsappLink, SITE } from '../../config/site';
import {
  products, primaryImage, formatPrice, discountPct, productPath,
  categoryPath, relatedProducts, plainText,
} from '../../lib/catalog';
import { productSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props;
const pct = discountPct(p);
const cat = p.categories[0];
const brand = p.brands[0];
const related = relatedProducts(p, 4);
const url = productPath(p.slug);

const metaDesc = plainText(p.shortDescriptionHtml || p.descriptionHtml, 155) ||
  `${p.name} al mejor precio en Lima, Perú. ${formatPrice(p.salePrice ?? p.price)}. Envíos a todo el Perú.`;

// OG image absoluta a partir de la imagen principal optimizada
const mainImg = primaryImage(p);
let ogImage = '/og-default.png';
if (mainImg) {
  const opt = await getImage({ src: mainImg, width: 1200, height: 1200, format: 'jpg' });
  ogImage = new URL(opt.src, SITE.url).toString();
}

const breadcrumbItems = [
  { name: 'Inicio', url: '/' },
  ...(cat ? [{ name: cat.name, url: categoryPath(cat.slug) }] : []),
  { name: p.name, url },
];
const waMsg = `Hola, me interesa el producto "${p.name}" (${formatPrice(p.salePrice ?? p.price)}). ¿Está disponible?`;

const jsonLd = [
  productSchema(p, { url: new URL(url, SITE.url).toString(), image: ogImage }),
  breadcrumbSchema(breadcrumbItems),
];
const title = `${p.name} | Precio en Perú | ${SITE.name}`.slice(0, 65);
---
<Layout title={title} description={metaDesc} canonical={url} type="product" image={ogImage} jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />

  <section class="container-page grid gap-10 py-8 lg:grid-cols-2">
    <ProductGallery product={p} />

    <div>
      {cat && <a href={categoryPath(cat.slug)} class="text-sm font-semibold uppercase tracking-wide text-brand-500 hover:text-brand-600">{cat.name}</a>}
      <h1 class="mt-1 text-2xl font-extrabold leading-tight text-brand-950 sm:text-3xl">{p.name}</h1>

      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-brand-500">
        {brand && <span class="inline-flex items-center gap-1.5"><Icon name="star" size={15} class="text-gold-500" /> {brand.name}</span>}
        {p.sku && <span>SKU: {p.sku}</span>}
        <span class:list={['inline-flex items-center gap-1.5 font-semibold', p.inStock ? 'text-green-600' : 'text-red-600']}>
          <Icon name="check" size={15} /> {p.inStock ? 'En stock' : 'Agotado'}
        </span>
      </div>

      <div class="mt-5 flex flex-wrap items-baseline gap-3">
        <span class="text-3xl font-extrabold text-brand-700">{formatPrice(p.salePrice ?? p.price)}</span>
        {pct && p.regularPrice && (
          <>
            <span class="text-lg text-brand-400 line-through">{formatPrice(p.regularPrice)}</span>
            <span class="rounded-full bg-gold-400 px-2.5 py-1 text-xs font-extrabold text-ink">Ahorra {pct}%</span>
          </>
        )}
      </div>
      <p class="mt-1 text-xs text-brand-400">Precio en soles (S/). IGV incluido. Consulta opciones de envío a todo el Perú.</p>

      {p.shortDescriptionHtml && (
        <div class="prose-wi mt-5 max-w-none border-t border-brand-100 pt-5" set:html={p.shortDescriptionHtml} />
      )}

      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href={whatsappLink(waMsg)} target="_blank" rel="noopener" class="inline-flex flex-1 items-center justify-center gap-2 rounded-xl bg-[#25D366] px-6 py-3.5 font-extrabold text-white transition hover:brightness-95">
          <Icon name="whatsapp" size={20} /> Comprar por WhatsApp
        </a>
        <a href="/contacto/" class="inline-flex items-center justify-center gap-2 rounded-xl border border-brand-200 px-6 py-3.5 font-semibold text-brand-800 transition hover:bg-brand-50">
          <Icon name="phone" size={18} /> Consultar
        </a>
      </div>

      {p.attributes.length > 0 && (
        <div class="mt-6 overflow-hidden rounded-xl border border-brand-100">
          <table class="w-full text-sm">
            <tbody class="divide-y divide-brand-100">
              {p.attributes.map((a) => (
                <tr>
                  <th class="bg-brand-50 px-4 py-2 text-left font-semibold text-brand-700">{a.name}</th>
                  <td class="px-4 py-2 text-brand-700">{a.terms.join(', ')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </section>

  {p.descriptionHtml && (
    <section class="container-page py-6">
      <h2 class="text-xl font-extrabold text-brand-950">Descripción</h2>
      <div class="prose-wi mt-4 max-w-3xl" set:html={p.descriptionHtml} />
    </section>
  )}

  {related.length > 0 && (
    <section class="border-t border-brand-100 bg-brand-50 py-14">
      <div class="container-page">
        <h2 class="text-2xl font-extrabold text-brand-950">Productos relacionados</h2>
        <div class="mt-8 grid grid-cols-2 gap-5 lg:grid-cols-4">
          {related.map((r) => <ProductCard product={r} />)}
        </div>
      </div>
    </section>
  )}

  <CTASection message={`Hola, quisiera más información sobre "${p.name}".`} />
</Layout>
