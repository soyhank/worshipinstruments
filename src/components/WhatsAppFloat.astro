---
import { whatsappLink, CONTACT } from '../config/site';
import Icon from './Icon.astro';
---
<a href={whatsappLink()} target="_blank" rel="noopener"
  class="group fixed bottom-5 right-5 z-50 flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-3 font-bold text-white shadow-lg transition hover:scale-105 hover:bg-[#1ebe5b]"
  aria-label={`Escríbenos por WhatsApp al ${CONTACT.whatsappDisplay}`}>
  <Icon name="whatsapp" size={26} />
  <span class="hidden text-sm sm:inline">Cotiza por WhatsApp</span>
</a>
