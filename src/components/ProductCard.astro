---
import { Image } from 'astro:assets';
import type { Product } from '../lib/catalog';
import { primaryImage, formatPrice, discountPct, productPath } from '../lib/catalog';
import Icon from './Icon.astro';

interface Props { product: Product; loading?: 'lazy' | 'eager' }
const { product, loading = 'lazy' } = Astro.props;
const img = primaryImage(product);
const pct = discountPct(product);
const cat = product.categories[0];
const brand = product.brands[0];
const href = productPath(product.slug);
---
<article class="group flex flex-col">
  <a href={href} class="img-zoom relative block aspect-square overflow-hidden rounded-2xl border border-brand-100 bg-white p-5 transition-colors group-hover:border-brand-300">
    {img ? (
      <Image src={img} alt={product.images[0]?.alt ?? product.name} widths={[220, 440]} sizes="(max-width:640px) 50vw, 25vw" loading={loading} class="h-full w-full object-contain" />
    ) : (
      <div class="grid h-full place-items-center text-brand-200"><Icon name="music" size={48} /></div>
    )}
    {pct && <span class="absolute left-4 top-4 rounded-full bg-gold-400 px-2.5 py-1 text-xs font-extrabold text-ink">-{pct}%</span>}
    {!product.inStock && <span class="absolute right-4 top-4 rounded-full bg-brand-900/85 px-2.5 py-1 text-xs font-semibold text-white">Agotado</span>}
  </a>

  <div class="flex flex-1 flex-col px-1 pt-4">
    <p class="eyebrow text-[0.65rem]">{brand?.name ?? cat?.name ?? ''}</p>
    <h3 class="mt-1.5 text-sm font-bold leading-snug text-brand-950">
      <a href={href} class="clamp-2 transition-colors hover:text-brand-600">{product.name}</a>
    </h3>
    <div class="mt-3 flex flex-1 flex-col justify-end gap-3">
      <div class="flex items-baseline gap-2">
        <span class="text-lg font-extrabold text-brand-900">{formatPrice(product.salePrice ?? product.price)}</span>
        {pct && product.regularPrice && <span class="text-sm text-brand-400 line-through">{formatPrice(product.regularPrice)}</span>}
      </div>
      <a href={href} class="link-cta text-sm">
        Explorar <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>
</article>
