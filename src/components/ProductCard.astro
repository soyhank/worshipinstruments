---
import { Image } from 'astro:assets';
import type { Product } from '../lib/catalog';
import { primaryImage, formatPrice, discountPct, productPath } from '../lib/catalog';
import Icon from './Icon.astro';

interface Props { product: Product; loading?: 'lazy' | 'eager' }
const { product, loading = 'lazy' } = Astro.props;
const img = primaryImage(product);
const pct = discountPct(product);
const cat = product.categories[0];
const href = productPath(product.slug);
---
<article class="group flex flex-col overflow-hidden rounded-2xl border border-brand-100 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-card">
  <a href={href} class="relative block aspect-square overflow-hidden bg-white p-3">
    {img ? (
      <Image src={img} alt={product.images[0]?.alt ?? product.name} widths={[200, 400]} sizes="(max-width:640px) 50vw, 25vw" loading={loading} class="h-full w-full object-contain transition duration-300 group-hover:scale-105" />
    ) : (
      <div class="grid h-full place-items-center text-brand-200"><Icon name="music" size={48} /></div>
    )}
    {pct && <span class="absolute left-3 top-3 rounded-full bg-gold-400 px-2.5 py-1 text-xs font-extrabold text-ink">-{pct}%</span>}
    {!product.inStock && <span class="absolute right-3 top-3 rounded-full bg-brand-900/80 px-2.5 py-1 text-xs font-semibold text-white">Agotado</span>}
  </a>
  <div class="flex flex-1 flex-col p-4">
    {cat && <a href={`/categoria/${cat.slug}/`} class="text-xs font-semibold uppercase tracking-wide text-brand-400 hover:text-brand-600">{cat.name}</a>}
    <h3 class="mt-1 line-clamp-2 text-sm font-bold leading-snug text-brand-900">
      <a href={href} class="hover:text-brand-600 clamp-2">{product.name}</a>
    </h3>
    <div class="mt-3 flex flex-1 flex-col justify-end">
      <div class="flex items-baseline gap-2">
        <span class="text-lg font-extrabold text-brand-700">{formatPrice(product.salePrice ?? product.price)}</span>
        {pct && product.regularPrice && <span class="text-sm text-brand-400 line-through">{formatPrice(product.regularPrice)}</span>}
      </div>
      <a href={href} class="mt-3 inline-flex items-center justify-center gap-1.5 rounded-lg bg-brand-600 px-3 py-2.5 text-sm font-bold text-white transition hover:bg-brand-700">
        Ver producto <Icon name="arrow" size={15} class="transition group-hover:translate-x-0.5" />
      </a>
    </div>
  </div>
</article>
